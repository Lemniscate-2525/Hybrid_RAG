# -------------------------------------------------------------
# Production Hybrid RAG Environment Configuration
# Copy this file to .env and populate your credentials.
# -------------------------------------------------------------

# Application Settings
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production-use-a-strong-random-key-64-bytes-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Inference (Supports OpenRouter Free Models, Mistral, or any OpenAI-compatible API)
# Get a free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Alternative free models on OpenRouter:
# LLM_MODEL=mistralai/mistral-7b-instruct:free
# LLM_MODEL=deepseek/deepseek-r1:free
# LLM_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free

# Vector Database (Qdrant)
# Leave empty to use local embedded storage in data/qdrant_local
Qdrant_URL=
Qdrant_API_KEY=
Collection_Name=hybrid_rag_documents

# Redis Caching & Distributed Rate Limiting
# Leave default to connect to local Redis, or uses embedded FakeRedis if daemon not running
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_ENABLED=true
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL_SECONDS=3600

# Rate Limits (Requests per window)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_QUERY_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_HOUR=20

# Ingestion Guardrails
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_DOCUMENT_PAGES=150
MAX_QUERY_LENGTH=500

# Reliability & Circuit Breaker
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30.0
