# -------------------------------------------------------------
# Production Hybrid RAG Environment Configuration
# Copy this file to .env and populate your credentials.
# -------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production-use-a-strong-random-key-64-bytes-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Main LLM inference (FreeLLMAPI / OpenAI-compatible provider)
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://your-provider.example/v1/chat/completions
LLM_MODEL=your-model-id

# Optional judge-specific key; falls back to LLM_API_KEY.
LOCAL_EVAL_API=
OPENROUTER_API_KEY=

# Evaluation runner authentication. Prefer a dedicated low-privilege account.
EVAL_API_TOKEN=
EVAL_EMAIL=
EVAL_PASSWORD=
RAG_API_BASE_URL=http://127.0.0.1:8000
EVAL_TOP_K=10
EVAL_METRIC_K=5

# Set the SAME long random secret in backend and local evaluation runner.
# Without it, raw pre-rerank chunk telemetry is disabled.
EVALUATION_DEBUG_TOKEN=

# LangSmith tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hybrid-rag-evaluation

# Vector Database (Qdrant)
Qdrant_URL=
Qdrant_API_KEY=
Collection_Name=hybrid_rag_documents

# Redis Caching & Distributed Rate Limiting
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_ENABLED=true
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL_SECONDS=3600

RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_QUERY_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_HOUR=20

MAX_UPLOAD_SIZE_BYTES=15728640
MAX_DOCUMENT_PAGES=150
MAX_QUERY_LENGTH=500

LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30.0
