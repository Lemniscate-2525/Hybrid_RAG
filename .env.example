# -------------------------------------------------------------
# Production Hybrid RAG Environment Configuration
# Copy this file to .env and populate appropriate credentials.
# -------------------------------------------------------------

# Application Settings
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=generate-a-strong-random-64-character-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vector Database (Qdrant Cloud or Self-Hosted)
# Leave empty to use local embedded storage for development
Qdrant_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
Qdrant_API_KEY=your-qdrant-api-key
Collection_Name=hybrid_rag_documents

# Mistral AI LLM Inference
MistralAI=your-mistral-ai-api-key
MISTRAL_MODEL=open-mixtral-8x7b

# Redis Caching & Distributed Rate Limiting
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_ENABLED=true
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL_SECONDS=3600

# Rate Limits (Requests per window)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_QUERY_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_HOUR=20

# Ingestion Guardrails
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_DOCUMENT_PAGES=150
MAX_QUERY_LENGTH=500

# Reliability & Circuit Breaker
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30.0

